{
  "name": "claimguard",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "hostRequirements": { "cpus": 2 },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ]
    }
  },
  "postCreateCommand": "pip install --upgrade pip && pip install ruff pytest pre-commit"
}
